+-- Effective, replayable search_path for the capturing role: "$user" is
+-- expanded to the role name (and dropped when no such schema/role exists),
+-- the "" empty-schema marker and names that do not resolve to a namespace
+-- are dropped, and search order is preserved. Only schemas present in
+-- pg_namespace survive, which is exactly the list Postgres walks.
+-- name: fetch-search-path
+WITH parts(ord, token) AS (
+    SELECT u.ord, btrim(u.token)
+      FROM (SELECT pg_catalog.current_setting('search_path') AS setting) AS raw,
+           unnest(string_to_array(raw.setting, ',')) WITH ORDINALITY AS u(token, ord)
+),
+expanded(ord, nspname) AS (
+    SELECT parts.ord,
+           CASE
+               WHEN lower(parts.token) IN ('$user', '"$user"')
+                   THEN (SELECT r.rolname
+                           FROM pg_catalog.pg_roles r
+                          WHERE r.rolname = current_user)
+               WHEN parts.token = '""' THEN NULL
+               ELSE btrim(parts.token, '"')
+           END
+      FROM parts
+)
+SELECT e.nspname
+  FROM expanded e
+ WHERE e.nspname IS NOT NULL
+   AND e.nspname <> ''
+   AND EXISTS (SELECT 1 FROM pg_catalog.pg_namespace n WHERE n.nspname = e.nspname)
+ ORDER BY e.ord
+
 -- name: fetch-gucs
 SELECT name, setting, unit
   FROM pg_catalog.pg_settings
diff --git a/pkg/snapshot/resolve.go b/pkg/snapshot/resolve.go
new file mode 100644
index 0000000..d3dc02d
--- /dev/null
+++ b/pkg/snapshot/resolve.go
@@ -0,0 +1,282 @@
+package snapshot
+
+import (
+	"sort"
+	"strings"
+)
+
+// LegacyDefaultSchema is what every name resolved against before snapshots
+// carried an effective search_path. Old history.db rows and remote bundles
+// without one keep this behavior.
+const LegacyDefaultSchema = "public"
+
+// EffectiveSearchPath is the replayable schema order names resolve along:
+// trimmed, de-duplicated entries from the captured list. A nil snapshot, an
+// empty list, or a list holding only empty/unreadable entries resolves the
+// legacy way as ["public"]. Explicit schema qualifiers never consult this.
+func EffectiveSearchPath(s *SchemaSnapshot) []string {
+	if s == nil || len(s.SearchPath) == 0 {
+		return []string{LegacyDefaultSchema}
+	}
+	out := make([]string, 0, len(s.SearchPath))
+	seen := make(map[string]bool, len(s.SearchPath))
+	for _, raw := range s.SearchPath {
+		name := strings.TrimSpace(raw)
+		// an empty or unreadable entry is skipped, exactly as Postgres
+		// skips a schema it cannot find on the path
+		if name == "" || seen[name] {
+			continue
+		}
+		seen[name] = true
+		out = append(out, name)
+	}
+	if len(out) == 0 {
+		return []string{LegacyDefaultSchema}
+	}
+	return out
+}
+
+// quoteSettingIdent renders one schema name for SET LOCAL search_path.
+// Quoting every entry is always legal; doubling embedded quotes keeps the
+// value injection-safe.
+func quoteSettingIdent(s string) string {
+	return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
+}
+
+// SearchPathSetting renders the effective path as a SET LOCAL value that
+// replays the same resolution order in a live session:
+//
+//	"app", "tenant", public
+//
+// Every entry is quoted, so mixed-case or punctuation-bearing names survive
+// the round trip, and a schema missing from the live catalog is skipped by
+// Postgres rather than erroring.
+func SearchPathSetting(s *SchemaSnapshot) string {
+	path := EffectiveSearchPath(s)
+	parts := make([]string, len(path))
+	for i, sch := range path {
+		parts[i] = quoteSettingIdent(sch)
+	}
+	return strings.Join(parts, ", ")
+}
+
+type RelationKind uint8
+
+const (
+	RelNone RelationKind = iota
+	RelTable
+	RelView
+)
+
+// Resolver applies the single relation-resolution rule every analysis entry
+// point shares: an explicit schema qualifier is authoritative and never
+// falls back; an unqualified name picks the first match along the snapshot's
+// effective search_path, so same-named objects in different schemas resolve
+// to exactly one table/view, its own columns, constraints and statistics.
+//
+// A Resolver is built per use from one snapshot; holding no package-level
+// state, two snapshots (different profiles or databases) can never leak
+// resolution state into each other.
+type Resolver struct {
+	snap *SchemaSnapshot
+	path []string
+
+	tables map[QualifiedName]*Table
+	views  map[QualifiedName]*View
+
+	// first object holding a bare name along path order
+	bareTable map[string]*Table
+	bareView  map[string]*View
+	bareRel   map[string]resolvedRel
+}
+
+type resolvedRel struct {
+	kind  RelationKind
+	q     QualifiedName
+	table *Table
+	view  *View
+}
+
+// NewResolver indexes one snapshot. A nil snapshot resolves as legacy
+// ["public"] against no objects, which yields stable missing results rather
+// than panicking.
+func NewResolver(s *SchemaSnapshot) *Resolver {
+	r := &Resolver{
+		snap:      s,
+		path:      EffectiveSearchPath(s),
+		tables:    make(map[QualifiedName]*Table),
+		views:     make(map[QualifiedName]*View),
+		bareTable: make(map[string]*Table),
+		bareView:  make(map[string]*View),
+		bareRel:   make(map[string]resolvedRel),
+	}
+	if s == nil {
+		return r
+	}
+	for i := range s.Tables {
+		t := &s.Tables[i]
+		r.tables[QualifiedName{Schema: t.Schema, Name: t.Name}] = t
+	}
+	for i := range s.Views {
+		v := &s.Views[i]
+		r.views[QualifiedName{Schema: v.Schema, Name: v.Name}] = v
+	}
+	// path order is the outer loop so an object in an earlier schema always
+	// shadows a same-named one in a later schema
+	for _, sch := range r.path {
+		for i := range s.Tables {
+			t := &s.Tables[i]
+			if t.Schema != sch {
+				continue
+			}
+			if _, ok := r.bareRel[t.Name]; !ok {
+				q := QualifiedName{Schema: t.Schema, Name: t.Name}
+				r.bareRel[t.Name] = resolvedRel{kind: RelTable, q: q, table: t}
+				r.bareTable[t.Name] = t
+			}
+		}
+		for i := range s.Views {
+			v := &s.Views[i]
+			if v.Schema != sch {
+				continue
+			}
+			if _, ok := r.bareRel[v.Name]; !ok {
+				q := QualifiedName{Schema: v.Schema, Name: v.Name}
+				r.bareRel[v.Name] = resolvedRel{kind: RelView, q: q, view: v}
+				r.bareView[v.Name] = v
+			}
+		}
+	}
+	return r
+}
+
+// Path returns a copy of the effective schema order, earliest first.
+func (r *Resolver) Path() []string {
+	return append([]string(nil), r.path...)
+}
+
+// Snapshot returns the snapshot this resolver was built for.
+func (r *Resolver) Snapshot() *SchemaSnapshot { return r.snap }
+
+// ResolveTable finds the table an explicit ("schema.name") or unqualified
+// ("name") reference denotes. An explicit schema is matched exactly and
+// never falls through to search_path. The returned QualifiedName is the
+// unique identity columns, constraints, indexes and stats must be read with.
+func (r *Resolver) ResolveTable(explicitSchema, name string) (*Table, QualifiedName, bool) {
+	if explicitSchema != "" {
+		t := r.tables[QualifiedName{Schema: explicitSchema, Name: name}]
+		if t == nil {
+			return nil, QualifiedName{Schema: explicitSchema, Name: name}, false
+		}
+		return t, t.Qual(), true
+	}
+	t := r.bareTable[name]
+	if t == nil {
+		return nil, QualifiedName{Schema: r.TargetSchema(), Name: name}, false
+	}
+	return t, t.Qual(), true
+}
+
+// ResolveView is ResolveTable for views and materialized views.
+func (r *Resolver) ResolveView(explicitSchema, name string) (*View, QualifiedName, bool) {
+	if explicitSchema != "" {
+		v := r.views[QualifiedName{Schema: explicitSchema, Name: name}]
+		if v == nil {
+			return nil, QualifiedName{Schema: explicitSchema, Name: name}, false
+		}
+		return v, QualifiedName{Schema: v.Schema, Name: v.Name}, true
+	}
+	v := r.bareView[name]
+	if v == nil {
+		return nil, QualifiedName{Schema: r.TargetSchema(), Name: name}, false
+	}
+	return v, QualifiedName{Schema: v.Schema, Name: v.Name}, true
+}
+
+// LookupRelation resolves a table-or-view reference under one rule,
+// reporting which kind was found. Views and tables share a namespace in
+// Postgres, so within a schema the name can only denote one of them.
+func (r *Resolver) LookupRelation(explicitSchema, name string) (RelationKind, QualifiedName, bool) {
+	if explicitSchema != "" {
+		q := QualifiedName{Schema: explicitSchema, Name: name}
+		if t := r.tables[q]; t != nil {
+			return RelTable, t.Qual(), true
+		}
+		if v := r.views[q]; v != nil {
+			return RelView, QualifiedName{Schema: v.Schema, Name: v.Name}, true
+		}
+		return RelNone, q, false
+	}
+	if rel, ok := r.bareRel[name]; ok {
+		return rel.kind, rel.q, true
+	}
+	return RelNone, QualifiedName{Schema: r.TargetSchema(), Name: name}, false
+}
+
+// TargetSchema is where an unqualified CREATE puts a new object: the first
+// creatable entry of the path. The captured list already excludes empty and
+// non-existent schemas.
+func (r *Resolver) TargetSchema() string {
+	if len(r.path) > 0 {
+		return r.path[0]
+	}
+	return LegacyDefaultSchema
+}
+
+// ResolveSchemaName says which schema a parsed RangeVar denotes. An explicit
+// qualifier always wins, even when nothing is in it yet. An unqualified name
+// on an existing object resolves to that object's schema (first on the
+// path); on a name the snapshot does not hold it denotes the creation
+// target, which is also the legacy default "public" for old bundles.
+func (r *Resolver) ResolveSchemaName(explicitSchema, name string) string {
+	if explicitSchema != "" {
+		return explicitSchema
+	}
+	if rel, ok := r.bareRel[name]; ok {
+		return rel.q.Schema
+	}
+	return r.TargetSchema()
+}
+
+// AllNamedRelations returns every table/view holding the bare name,
+// qualified, sorted by schema then name. It backs "the name exists in
+// several schemas" diagnostics for callers that take unqualified input
+// outside of SQL text (e.g. the describe_table tool).
+func (r *Resolver) AllNamedRelations(name string) []QualifiedName {
+	var out []QualifiedName
+	for q := range r.tables {
+		if q.Name == name {
+			out = append(out, q)
+		}
+	}
+	for q := range r.views {
+		if q.Name == name {
+			out = append(out, q)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Schema != out[j].Schema {
+			return out[i].Schema < out[j].Schema
+		}
+		return out[i].Name < out[j].Name
+	})
+	return out
+}
+
+// AllNamedRelationsInSchema lists every table/view in one schema, sorted by
+// name. Used to build the typo-candidate pool reachable from one path entry.
+func (r *Resolver) AllNamedRelationsInSchema(sch string) []QualifiedName {
+	var out []QualifiedName
+	for q := range r.tables {
+		if q.Schema == sch {
+			out = append(out, q)
+		}
+	}
+	for q := range r.views {
+		if q.Schema == sch {
+			out = append(out, q)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out
+}
diff --git a/pkg/snapshot/resolve_test.go b/pkg/snapshot/resolve_test.go
new file mode 100644
index 0000000..1498a0b
--- /dev/null
+++ b/pkg/snapshot/resolve_test.go
@@ -0,0 +1,196 @@
+package snapshot
+
+import (
+	"reflect"
+	"testing"
+)
+
+func searchPathSnap() *SchemaSnapshot {
+	return &SchemaSnapshot{
+		SearchPath: []string{"app", "tenant", "public"},
+		Tables: []Table{
+			{Schema: "app", Name: "orders", Columns: []Column{{Name: "app_col"}, {Name: "id"}}},
+			{Schema: "tenant", Name: "orders", Columns: []Column{{Name: "tenant_col"}, {Name: "id"}}},
+			{Schema: "public", Name: "orders", Columns: []Column{{Name: "pub_col"}, {Name: "id"}}},
+			{Schema: "app", Name: "events"},
+		},
+		Views: []View{
+			{Schema: "app", Name: "summary"},
+			{Schema: "public", Name: "summary"},
+		},
+	}
+}
+
+func TestEffectiveSearchPath_LegacyFallback(t *testing.T) {
+	if got := EffectiveSearchPath(nil); !reflect.DeepEqual(got, []string{"public"}) {
+		t.Errorf("nil snap = %v, want [public]", got)
+	}
+	if got := EffectiveSearchPath(&SchemaSnapshot{}); !reflect.DeepEqual(got, []string{"public"}) {
+		t.Errorf("empty path = %v, want [public]", got)
+	}
+	if got := EffectiveSearchPath(&SchemaSnapshot{SearchPath: []string{"  ", "", "x"}}); !reflect.DeepEqual(got, []string{"x"}) {
+		t.Errorf("garbage-only path = %v, want [x]", got)
+	}
+}
+
+func TestEffectiveSearchPath_CleansRepeats(t *testing.T) {
+	s := &SchemaSnapshot{SearchPath: []string{" app ", "app", "tenant", "", "tenant"}}
+	got := EffectiveSearchPath(s)
+	want := []string{"app", "tenant"}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %v, want %v", got, want)
+	}
+}
+
+func TestResolver_BareNameFollowsPathOrder(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	tbl, q, ok := r.ResolveTable("", "orders")
+	if !ok {
+		t.Fatal("orders should resolve")
+	}
+	if q.Schema != "app" {
+		t.Fatalf("bare orders resolved to %s, want app", q.Schema)
+	}
+	if len(tbl.Columns) != 2 || tbl.Columns[0].Name != "app_col" {
+		t.Fatalf("got columns %+v, want the app table's own columns", tbl.Columns)
+	}
+}
+
+func TestResolver_ExplicitSchemaNeverFallsBack(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	tbl, q, ok := r.ResolveTable("tenant", "orders")
+	if !ok || q.Schema != "tenant" {
+		t.Fatalf("explicit tenant.orders = %+v %v %v", tbl, q, ok)
+	}
+	if tbl.Columns[0].Name != "tenant_col" {
+		t.Fatalf("got %s's columns from another schema: %+v", q.Schema, tbl.Columns)
+	}
+
+	// an explicit schema that lacks the relation must not fall back to app,
+	// even though app is earlier on the path and holds it
+	if _, _, ok := r.ResolveTable("public", "events"); ok {
+		t.Fatal("public.events must not silently resolve to app.events")
+	}
+	if _, _, ok := r.ResolveTable("missing_schema", "orders"); ok {
+		t.Fatal("missing schema must not fall back along search_path")
+	}
+}
+
+func TestResolver_TableAndViewShareOneRule(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	kind, q, ok := r.LookupRelation("", "summary")
+	if !ok || kind != RelView || q.Schema != "app" {
+		t.Fatalf("bare summary = %v %v %v", kind, q, ok)
+	}
+	kind, _, ok = r.LookupRelation("public", "summary")
+	if !ok || kind != RelView {
+		t.Fatalf("public summary = %v %v", kind, ok)
+	}
+	kind, _, ok = r.LookupRelation("", "events")
+	if !ok || kind != RelTable {
+		t.Fatalf("events = %v %v", kind, ok)
+	}
+	if _, _, ok := r.LookupRelation("", "nope"); ok {
+		t.Fatal("missing relation should report absent")
+	}
+}
+
+func TestResolver_ResolveView(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	v, q, ok := r.ResolveView("", "summary")
+	if !ok || q.Schema != "app" || v.Name != "summary" {
+		t.Fatalf("bare summary view = %+v %v %v", v, q, ok)
+	}
+	if _, _, ok := r.ResolveView("tenant", "summary"); ok {
+		t.Fatal("tenant has no summary view")
+	}
+}
+
+func TestResolver_SchemaNameAndTarget(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	if got := r.ResolveSchemaName("", "orders"); got != "app" {
+		t.Errorf("existing bare name = %q, want app", got)
+	}
+	// a name the snapshot does not hold denotes the creation target
+	if got := r.ResolveSchemaName("", "brand_new"); got != "app" {
+		t.Errorf("new bare name = %q, want app", got)
+	}
+	if got := r.ResolveSchemaName("explicit_schema", "brand_new"); got != "explicit_schema" {
+		t.Errorf("explicit = %q, want explicit_schema", got)
+	}
+	if got := r.TargetSchema(); got != "app" {
+		t.Errorf("target = %q, want app", got)
+	}
+
+	// legacy bundle: creation target stays public
+	legacy := NewResolver(&SchemaSnapshot{Tables: []Table{{Schema: "public", Name: "t"}}})
+	if got := legacy.ResolveSchemaName("", "brand_new"); got != "public" {
+		t.Errorf("legacy target = %q, want public", got)
+	}
+}
+
+func TestResolver_AllNamedRelations(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	got := r.AllNamedRelations("orders")
+	want := []QualifiedName{
+		{Schema: "app", Name: "orders"},
+		{Schema: "public", Name: "orders"},
+		{Schema: "tenant", Name: "orders"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("holders = %v, want %v", got, want)
+	}
+}
+
+func TestResolver_NilSnapshotIsSafe(t *testing.T) {
+	r := NewResolver(nil)
+	if got := r.Path(); !reflect.DeepEqual(got, []string{"public"}) {
+		t.Errorf("nil resolver path = %v", got)
+	}
+	if _, _, ok := r.ResolveTable("", "anything"); ok {
+		t.Error("nil snapshot must not resolve")
+	}
+	if _, _, ok := r.ResolveTable("app", "anything"); ok {
+		t.Error("nil snapshot explicit lookup must not resolve")
+	}
+}
+
+func TestSearchPathSetting(t *testing.T) {
+	if got := SearchPathSetting(&SchemaSnapshot{SearchPath: []string{"app", "public"}}); got != `"app", "public"` {
+		t.Errorf("setting = %q", got)
+	}
+	// embedded quotes are doubled so SET LOCAL cannot be injected through
+	if got := SearchPathSetting(&SchemaSnapshot{SearchPath: []string{`a"b`}}); got != `"a""b"` {
+		t.Errorf("quoting = %q", got)
+	}
+	if got := SearchPathSetting(nil); got != `"public"` {
+		t.Errorf("legacy setting = %q, want \"public\"", got)
+	}
+}
+
+func TestResolver_PathIsACopy(t *testing.T) {
+	r := NewResolver(searchPathSnap())
+	p := r.Path()
+	p[0] = "mutated"
+	if r.Path()[0] != "app" {
+		t.Fatal("Path() must return a copy; a caller mutated resolver state")
+	}
+}
+
+// search_path is resolution context, not DDL: adding it must not move the
+// content hash, or a capture after this feature would dedupe away from every
+// pre-feature snapshot and old bundles would read as drifted.
+func TestContentHash_IgnoresSearchPath(t *testing.T) {
+	base := func() *SchemaSnapshot {
+		return &SchemaSnapshot{
+			FormatVersion: FormatVersion,
+			Tables:        []Table{{Schema: "app", Name: "orders", Columns: []Column{{Name: "id"}}}},
+		}
+	}
+	without := DigestFor(base())
+	withPath := base()
+	withPath.SearchPath = []string{"app", "tenant", "public"}
+	if got := DigestFor(withPath); got != without {
+		t.Fatalf("search_path moved the content hash: %s vs %s", got, without)
+	}
+}
